# ──────────────────────────────────────────────────────────
# InsuraQuery 环境变量模板
# 复制本文件为 .env 并填入你自己的密钥后使用： cp .env.example .env
# ──────────────────────────────────────────────────────────

# ── Elasticsearch ────────────────────────────────────────
# 本地自建可参考 docker-compose.yml（生成 elastic 密码后填入）
ES_HOST=https://localhost:9200
ES_USER=elastic
ES_PASS=your_elastic_password
ES_INDEX=knowledge_base

# ── Jina Embeddings (https://jina.ai/) ─────────────────────
JINA_API_KEY=your_jina_api_key
JINA_MODEL=jina-embeddings-v3
JINA_EMBED_DIMS=1024

# ── Tavily Web Search (https://tavily.com/) ────────────────
# 本地知识库足够时可不填，仅当 Route 走到 web 才会调用 Tavily
TAVILY_API_KEY=your_tavily_api_key

# ── LLM 服务（OpenAI 兼容接口 /chat/completions）────────────
# 默认对接任意 OpenAI 兼容网关；改 base/key/model 即可切换厂商
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=deepseek-v4-pro        # 问答主模型
LLM_MODEL_FAST=deepseek-v4-flash # 大上下文并行问答使用的快速模型
